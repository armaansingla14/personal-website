{
  "buildCommand": "vite build && node scripts/prerender-og.mjs",
  "redirects": [
    { "source": "/experience", "destination": "/work", "permanent": true },
    { "source": "/contact", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/work", "destination": "/work/index.html" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/writing", "destination": "/writing/index.html" },
    { "source": "/art", "destination": "/art/index.html" },
    {
      "source": "/writing/riemann-hypothesis",
      "destination": "/writing/riemann-hypothesis/index.html"
    },
    {
      "source": "/writing/voice-ai-bottleneck",
      "destination": "/writing/voice-ai-bottleneck/index.html"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
